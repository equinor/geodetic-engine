# The PROJ, proj-data and pyproj releases geodetic-engine is built, tested and
# released against, and where the matching pyproj wheels are published. This
# is the only place they are stated. To change them, follow
# runbooks/upgrading-proj-and-pyproj.md.
#
# KEY=VALUE lines only: no quotes, spaces or shell syntax; it is parsed, never
# sourced. Read by install-proj.sh, the workflows, scripts/sync_pins.py and the
# release scripts, and shipped in the wheel as geodetic_engine/_pins.env, where
# the package reads it on import.
PROJ_VERSION=9.9.0
PROJ_SHA256=791a0610547eeabb17006cfd49cdbd2034f3240f47ed5e88a1031811f4e2bcf3
PROJ_DATA_VERSION=1.25
PROJ_DATA_SHA256=16d65cb5d25b7d8492dbde4d39cafcc8c42f3e55e6715bac4d87519d6d08f4c8
PYPROJ_VERSION=3.8.0
PYPROJ_WHEEL_INDEX=https://equinor.github.io/geodetic-engine/simple/
