{
	"name": "geodetic-engine",
	"build": {
		"dockerfile": "Dockerfile"
	},
	// Copies host-trusted CAs (e.g. a TLS-intercepting proxy's) into certs/ for the build.
	"initializeCommand": "bash .devcontainer/collect-host-certs.sh",
	"features": {
		// moby-cli has no Debian 13 (trixie) packages; use upstream Docker CE instead.
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"moby": false
		}
	},
	"remoteUser": "vscode",
	// The image has no locales beyond C; a forwarded host LANG such as en_US.UTF-8
	// makes sphinx-build fail on start.
	//
	// PROJ_DATA puts local/proj-data (gitignored) first. Its proj.db is a link
	// scripts/install-osdu-projdb.sh manages: to build/proj.db, built on
	// container creation from the official OSDU catalogue committed in
	// catalogs/osdu/, or to the stock database when there is no build/proj.db
	// made for the installed PROJ. pyproj reads proj.db from the first entry,
	// so something is always linked there. The installed directory is never
	// modified and follows, for the grids and as the base every build starts
	// from; local/grids (gitignored, may be empty) comes last, so a grid dropped
	// there is found under its own filename. The Dockerfile's PROJ_DATA, the
	// installed directory alone, is what CI runs with.
	//
	// uv, httpx and requests ship their own CA bundles; point them at the system
	// store so the proxy CAs the Dockerfile installs from certs/ apply.
	"remoteEnv": {
		"LC_ALL": "C.UTF-8",
		"PROJ_DATA": "${containerWorkspaceFolder}/local/proj-data:/usr/local/share/proj:${containerWorkspaceFolder}/local/grids",
		"REQUESTS_CA_BUNDLE": "/etc/ssl/certs/ca-certificates.crt",
		"SSL_CERT_FILE": "/etc/ssl/certs/ca-certificates.crt"
	},
	// The OSDU install downloads nothing and never fails container creation: on
	// a failure it warns, and PROJ reads the earlier build/proj.db or, without
	// one, the stock database. A build/proj.db made for another PROJ release,
	// after an image upgrade say, is set aside and built again from scratch. On
	// every start the link is checked and whether the OSDU catalogue is
	// installed is reported again.
	"postCreateCommand": "uv sync --extra dev --extra docs && bash scripts/install-osdu-projdb.sh && uv run pytest tests/test_environment.py -q",
	"postStartCommand": "bash .devcontainer/link-local-grids.sh && bash scripts/install-osdu-projdb.sh --check",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"charliermarsh.ruff"
			],
			"settings": {
				"python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
				"python.terminal.activateEnvInCurrentTerminal": true
			}
		}
	}
}
