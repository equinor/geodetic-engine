# Credentials for `geodetic-projdb`.
#
# Copy this file to `.env` and fill in the values. `.env` is gitignored and must
# stay that way; it is the only place secrets belong.
#
# Everything that is not a secret goes in `geodetic-projdb.toml` instead. The
# loader rejects these two keys if it finds them in that file, so a credential
# cannot end up in version control by accident.
#
# In CI, do not create this file. Provide the same two variables from your
# secret store as environment variables for the build step only.

# OAuth2 client credentials for a machine account on your Georepository
# instance. Ask your Georepository administrator for a client credentials
# registration granted the API scope.
GEODETIC_ENGINE_GEOREP_CLIENT_ID=
GEODETIC_ENGINE_GEOREP_CLIENT_SECRET=

# Any setting from geodetic-projdb.toml can also be set here, prefixed with
# GEODETIC_ENGINE_, and takes precedence over the file. Useful for a one-off
# local override, but prefer the config file for anything permanent so the
# setting is reviewable.
# GEODETIC_ENGINE_OUTPUT_DB=build/proj.db
