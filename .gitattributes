# Shell scripts are executed inside Linux containers; a CRLF checkout makes the
# shebang resolve to "bash\r" and the script fails to run at all.
* text=auto eol=lf
*.sh text eol=lf
Dockerfile text eol=lf
*.png binary
*.jsonl text eol=lf
# Committed byte for byte as OSDU publishes it, CRLF included, so its SHA-256
# matches the one recorded beside it.
catalogs/osdu/*.json -text
